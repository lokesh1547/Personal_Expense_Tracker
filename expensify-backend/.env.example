PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=expensify
JWT_SECRET=somereallysecretkey
CLIENT_URL=http://localhost:5173

# --- Email & Alert Settings ---
# Option 1: Resend (Recommended)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Expensify <onboarding@resend.dev>

# Option 2: Standard SMTP / Gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM="Expensify Alerts" <your_email@gmail.com>

# Schedule (default: 0 9 1 * * -> 9:00 AM on 1st of every month)
MONTHLY_CRON_SCHEDULE=0 9 1 * *

# --- Gen AI Settings ---
# Get free API key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
